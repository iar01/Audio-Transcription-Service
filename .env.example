# Copy to .env and adjust. Real environment variables override values in .env.

# --- Infrastructure ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Empty = SQLite at <STORAGE_PATH>/volga.db (local development).
# Production example: postgresql+psycopg://volga:CHANGE_ME@localhost:5432/volga
DATABASE_URL=

# --- Celery workers ---------------------------------------------------------
# Processes (prefork) per worker. Each process loads its own Whisper model
# (~300-500 MB RAM for 'base' int8). Start at 1 and raise only if CPU/RAM allow.
CELERY_CONCURRENCY=1
# prefork (Linux/macOS) | solo (Windows default) | threads
CELERY_POOL=
CELERY_MAX_RETRIES=3
CELERY_RETRY_BACKOFF_BASE=5
CELERY_RETRY_BACKOFF_MAX=300
# Seconds before Redis redelivers an unacknowledged task. Must exceed the longest chunk.
CELERY_VISIBILITY_TIMEOUT=3600
CELERY_QUEUE=transcription

# --- Chunking (seconds) -----------------------------------------------------
AUDIO_CHUNK_DURATION=300
AUDIO_CHUNK_OVERLAP=3
# Recordings longer than this are split into chunks; shorter ones are processed whole.
CHUNKING_THRESHOLD=600
CHUNKING_ENABLED=true

# --- Recovery (seconds) -----------------------------------------------------
# A chunk 'processing' longer than this is considered orphaned (worker crash).
CHUNK_STALE_TIMEOUT=1800
# A job 'queued' longer than this without starting is re-enqueued on worker start.
QUEUED_STALE_TIMEOUT=300

# --- Storage ----------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_PATH=storage
# Terminal jobs older than this are removed by `python manage.py cleanup` (0 = keep forever).
RETENTION_DAYS=30
MAX_UPLOAD_SIZE_MB=500

# --- Transcription engine ---------------------------------------------------
# auto (faster-whisper if installed, else mock) | faster-whisper | mock
TRANSCRIPTION_ENGINE=auto
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Threads per model (0 = library default). With N worker processes, use about cores / N.
WHISPER_CPU_THREADS=0
WHISPER_VAD_FILTER=true

# --- API --------------------------------------------------------------------
SSE_POLL_INTERVAL=1.0
SSE_HEARTBEAT_INTERVAL=15
# Keep the legacy synchronous POST /api/transcribe endpoint
ENABLE_SYNC_TRANSCRIBE=true
LOG_LEVEL=INFO
